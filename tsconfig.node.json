{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // The local API entry point is typechecked here (it is Node-side, never part of the browser
  // bundle). The older generator scripts keep their existing status.
  "include": ["vite.config.ts", "vitest.config.ts", "scripts/serve-api.ts"]
}
